# ============================================================
# Trazzo - plantilla de variables de entorno
# ============================================================
# Copia este archivo como `.env` y coloca tus valores reales:
#
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (Bash)
#
# El archivo `.env` está en .gitignore y no se sube al repositorio.
# ============================================================

# Client ID de OAuth 2.0 para Google Sign-In.
# Créalo en Google Cloud Console > APIs y servicios > Credenciales.
# https://console.cloud.google.com/apis/credentials
#
# IMPORTANTE: las variables EXPO_PUBLIC_* se incluyen en texto plano
# dentro del paquete de la app. El Client ID de una app móvil no es un
# secreto, pero NUNCA pongas aquí el Client Secret ni claves privadas.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
